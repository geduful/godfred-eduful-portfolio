# Copy this file to `.env` to configure local secrets.
# NOTE: Never commit real values.

# Optional: endpoint of the email service used by the contact form.
# Defaults to the Vercel serverless function at /api/contact.
# Leave empty unless you are overriding the API route.
VITE_CONTACT_ENDPOINT=

# SERVER-ONLY — used by the /api/contact Vercel function (api/contact.mjs)
# to send contact-form messages through Resend (https://resend.com).
# Never prefix with VITE_ (that would expose it to the browser).
# Add this to Vercel: Settings → Environment Variables → RESEND_API_KEY.
RESEND_API_KEY=

# Optional: GitHub personal access token (no scopes needed) used ONLY by the
# local `npm run sync` script to raise the GitHub API rate limit
# from 60 to 5,000 requests/hour. Runs on your machine / CI — never bundled.
# Create one at https://github.com/settings/tokens (fine-grained, read-only,
# or a classic token with no scopes).
# GITHUB_TOKEN=
